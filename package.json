{
  "name": "forcify",
  "version": "1.0.0",
  "description": "Pressure for every device: 3D Touch, Force Touch and long-press fallback behind one force event.",
  "author": "Hux <huxpro@gmail.com>",
  "license": "MIT",
  "keywords": [
    "forcify",
    "3d touch",
    "force touch",
    "force",
    "pressure",
    "long press"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huxpro/forcify.git"
  },
  "bugs": "https://github.com/Huxpro/forcify/issues",
  "homepage": "https://huxpro.github.io/forcify",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/forcify.cjs",
  "module": "./dist/forcify.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/forcify.min.js",
  "jsdelivr": "./dist/forcify.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/forcify.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/forcify.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build && npm run verify-dist",
    "prepublishOnly": "npm run check",
    "verify-dist": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
